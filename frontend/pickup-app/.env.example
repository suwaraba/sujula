# Where the Sujula API lives, for a built app.
#
# Leave EMPTY for development: vite.config.ts proxies the API prefixes to the
# backend, which keeps the page and the API on one origin so the CSRF cookie is
# readable. Setting this in development defeats that.
#
# A cross-origin value needs CORS on the backend — see README.md, "Serving it".
VITE_API_BASE_URL=

# Origin the dev proxy forwards to. Defaults to http://localhost:8080.
VITE_DEV_API_TARGET=http://localhost:8080
