# Where the API lives.
#
# Left empty the app calls the same origin it was served from, which is how it
# should be deployed: one host, `/driver/**` and `/auth/**` reverse-proxied to
# Spring. Same-origin means no CORS to configure, no preflight on every custody
# event, and no token ever crossing an origin boundary.
#
# Set it only when you cannot put the API behind the same host.
VITE_API_BASE_URL=

# Dev only: what `vite dev` proxies /driver, /auth, /me to.
VITE_DEV_API_TARGET=http://localhost:8080

# Google Maps JavaScript API key, browser-restricted to this app's origin.
#
# Optional. Without it the app still works: every "Navigate" button opens the
# Google Maps app by deep link, which needs no key at all, and the in-app map
# is replaced by a card with the address and the distance. With it, the driver
# sees the shop, the destination and their own position on one map.
VITE_GOOGLE_MAPS_API_KEY=

# Map id for cloud-based map styling (optional; enables AdvancedMarkerElement).
VITE_GOOGLE_MAPS_MAP_ID=

# How the app turns a photograph into the `photoUrl` a custody event carries.
#
#   presign  — POST {VITE_MEDIA_PRESIGN_PATH}?contentType=… for a short-lived
#              upload URL, PUT the bytes straight to storage, send back the
#              public URL. Bytes never pass through the application server.
#   off      — no uploads. Delivery, which requires a photograph, will be
#              refused by the backend. Only for a deployment with no storage.
VITE_MEDIA_MODE=presign
VITE_MEDIA_PRESIGN_PATH=/driver/evidence/presign

# Minutes of inactivity before the app locks itself behind the driver's PIN.
# These phones are shared and left in vehicles.
VITE_LOCK_AFTER_MINUTES=5
