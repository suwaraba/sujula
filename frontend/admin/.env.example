# Where the Sujula API lives.
#
# Leave this EMPTY for local development. An empty base means every request is
# same-origin and Vite's dev proxy (see vite.config.ts) forwards it to the
# backend — which is what keeps the XSRF-TOKEN cookie readable and the CSRF
# double-submit working. The backend publishes no CORS configuration at all, so
# a cross-origin base only works behind a reverse proxy that puts this app and
# the API on one origin.
VITE_API_BASE_URL=

# Where the backend is, for the dev proxy only. Not used in a built bundle.
VITE_DEV_API_TARGET=http://localhost:8080

# Minutes of no keyboard, pointer or navigation activity before the console
# signs itself out. This surface moves money and reads every customer's
# details; an unattended laptop is the threat it is guarding against.
VITE_IDLE_TIMEOUT_MINUTES=20
