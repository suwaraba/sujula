# Copy to .env (git-ignored) and fill in. Read by the `staging` profile:
#     mvn -o spring-boot:run -Dspring-boot.run.profiles=staging
# Any provider left blank falls back safely; the rest still work.
# Properties-file syntax: KEY=value, no quotes, no `export`.

# ── Database (required) — Neon (PostgreSQL) ─────────────────────────────────
# Neon console → Connect → pick the DIRECT connection (turn "Connection pooling"
# off, so the host has no "-pooler"), then split its string
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# into these three:
DB_URL=jdbc:postgresql://HOST/DBNAME?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# For a MySQL instead:
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# ── Identity ────────────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# head -c 32 /dev/urandom | base64      (needed to save vendor bank details)
FIELD_ENCRYPTION_KEY=
# openssl rand -hex 32                  (invoice links survive a restart)
INVOICE_SIGNING_SECRET=

# ── Mail — Gmail with an App Password ───────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=
# Defaults to MAIL_USERNAME. Gmail rewrites any address it has not verified.
# MAIL_FROM=
# Where links in emails point, and where Stripe returns the buyer (the buyer app)
FRONTEND_URL=http://localhost:5177

# ── SMS — Twilio trial (sends only to numbers verified in the console) ──────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ── Push — Firebase Cloud Messaging ─────────────────────────────────────────
# Project settings → Service accounts → Generate new private key.
# A path to the JSON file, or: base64 -w0 key.json
FCM_CREDENTIALS=

# ── Images — Cloudflare R2 ──────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL=

# ── Payments ────────────────────────────────────────────────────────────────
# true = mock gateway marks card orders paid with no money moving.
# false + STRIPE_SECRET_KEY = real Stripe Checkout in test mode.
PAYMENT_MOCK_ENABLED=true
# sk_test_… from Developers → API keys
STRIPE_SECRET_KEY=
# whsec_… from the dashboard webhook, or printed by `stripe listen` locally
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5177/#/orders
STRIPE_CANCEL_URL=http://localhost:5177/#/orders
PAYMENT_CALLBACK_SECRET=

# ── Geocoding — Google (optional; addresses degrade without it) ─────────────
GOOGLE_GEOCODING_API_KEY=
